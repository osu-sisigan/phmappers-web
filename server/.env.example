# Matches the credentials in docker-compose.yml; copy to .env to get started.
DATABASE_URL="postgresql://phmappers:phmappers@localhost:5432/phmappers?schema=public"
PORT=4000

# Placeholders so the server starts without real osu! credentials. Replace them
# with real values (ask acno) to actually log in.
OSU_CLIENT_ID=1
OSU_CLIENT_SECRET=placeholder
OSU_REDIRECT_URI=http://localhost:4000/auth/osu/callback

COOKIE_SECRET=dev-only-secret
